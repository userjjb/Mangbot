+static void tool_query_flags(void)
+{
+	int f, i;
+	cptr slots = "abcdefghijkl@";
+
+	tool_ev_begin("flags");
+	printf(",\"flags\":{");
+	for (f = 0; f < 32; f++)
+	{
+		int off = 7 + f;
+		char buf[16];
+		int n = 0;
+
+		for (i = 0; i < 13 && i < MAX_OBJFLAGS_ROWS; i++)
+		{
+			char c;
+			if (off >= MAX_OBJFLAGS_COLS) break;
+			c = p_ptr->hist_flags[i][off].c;
+			if (c && c != '.' && c != ' ') buf[n++] = slots[i];
+		}
+		buf[n] = '\0';
+		if (f) putchar(',');
+		tool_json_str(tool_flag_names[f]);
